{
	"appId": "uk.co.swifttees.app",
	"appName": "Swift Tees",
	"webDir": "public",
	"server": {
		"url": "https://swifttees.co.uk",
		"cleartext": false,
		"allowNavigation": [
			"swifttees.co.uk",
			"*.swifttees.co.uk"
		]
	},
	"plugins": {
		"PushNotifications": {
			"presentationOptions": [
				"badge",
				"sound",
				"alert"
			]
		}
	},
	"packageClassList": [
		"PushNotificationsPlugin"
	]
}
